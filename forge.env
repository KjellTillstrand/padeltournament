# forge.env — padeltournament code-host configuration.
#
# Coordinates only, never credentials: the github adapter's authority is the
# ambient `gh auth login` session (or federated identity in CI).
# Full contract: docs/forge-port.md in dotfiles-claude.

FORGE_PLATFORM=github
FORGE_GITHUB_OWNER=KjellTillstrand
FORGE_GITHUB_REPO=padeltournament
