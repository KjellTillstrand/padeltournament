{
  "schema": "padeltournament/requirements-manifest/v1",
  "description": "Approved Requirements the acceptance suite must cover. An acceptance test verifies a requirement when its test title begins with the requirement tag followed by a colon, e.g. \"R-SCORE-ENTRY: <scenario>\". A test verifying several requirements lists the tags comma-separated before the colon, e.g. \"R-SCORE-ENTRY, R-POINTS-TOTAL: <scenario>\".",
  "title_convention": "^(R-[A-Z0-9-]+)(, R-[A-Z0-9-]+)*: ",
  "requirements": [
    { "tag": "R-SCHEDULE-SELECT", "id": 2, "title": "Select a preconfigured schedule", "method": "Automated Test" },
    { "tag": "R-POINTS-TOTAL", "id": 3, "title": "Set the points total per game", "method": "Automated Test" },
    { "tag": "R-NAME-UNIQUE", "id": 4, "title": "Unique, non-empty tournament name", "method": "Automated Test" },
    { "tag": "R-STATE-PERSIST", "id": 5, "title": "Resume after reload or crash", "method": "Automated Test" },
    { "tag": "R-PLAYER-NAMES", "id": 6, "title": "Name the players", "method": "Automated Test" },
    { "tag": "R-COURT-NAMES", "id": 7, "title": "Custom court names", "method": "Automated Test" },
    { "tag": "R-START-LOCK", "id": 8, "title": "Start the tournament and lock setup", "method": "Automated Test" },
    { "tag": "R-ROUND-NAV", "id": 9, "title": "Navigate between rounds", "method": "Automated Test" },
    { "tag": "R-SCORE-ENTRY", "id": 10, "title": "Auto-completing score entry", "method": "Automated Test" },
    { "tag": "R-TOURNAMENT-STORE", "id": 11, "title": "Save, load and delete tournaments", "method": "Automated Test" },
    { "tag": "R-SCOREBOARD", "id": 12, "title": "Ranked scoreboard with medal colors", "method": "Automated Test" },
    {
      "tag": "R-CLIENT-ONLY",
      "id": 13,
      "title": "Fully client-side operation",
      "method": "Demonstration",
      "note": "Demonstrated by the acceptance suite itself: it runs against a static http-server serving ./web with no backend (see .github/workflows/playwright-tests.yml), so every passing test shows the app operating fully client-side."
    },
    { "tag": "R-PERFECT-MIX", "id": 23, "title": "Full-length tournaments mix everyone perfectly", "method": "Automated Test" },
    { "tag": "R-EQUITABLE-MIX", "id": 24, "title": "Any-length schedules stay equitable", "method": "Automated Test" },
    { "tag": "R-SPACED-MIX", "id": 34, "title": "Repeat encounters are spread across the tournament", "method": "Automated Test" },
    { "tag": "R-FORMAT-SELECT", "id": 42, "title": "Choose the tournament format", "method": "Automated Test" },
    { "tag": "R-POINT-POOLS", "id": 43, "title": "Point pools 16, 21, 24 and 32", "method": "Automated Test" },
    { "tag": "R-TIEBREAK-H2H", "id": 44, "title": "Head-to-head tiebreak, then shared placement", "method": "Automated Test" },
    { "tag": "R-SITOUT-PLAY", "id": 45, "title": "Any count from 8 to 24 is playable, with rests spread fairly", "method": "Automated Test" },
    { "tag": "R-MEXICANO-PAIRING", "id": 46, "title": "Mexicano rounds pair by the live standings", "method": "Automated Test" },
    { "tag": "R-MEXICANO-ROUNDS", "id": 47, "title": "One round at a time, locked once it seeds the next", "method": "Automated Test" }
  ]
}
