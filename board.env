# board.env — padeltournament board configuration (mock adapter).
#
# File-backed board: offline, credential-free, full board-port semantics
# (claims, write-back, /audit-board). Chosen deliberately for this single-user
# project — see .claude/CLAUDE.md "Work Item Source".
#
# State: .claude/mock-board.json at the git toplevel (git-ignored — the board
# is durable on this machine but does NOT travel with the repo).
# Authority: the invoking OS user's write access to that file; nothing to
# authenticate, nothing to rotate. BOARD_DRY_RUN=1 forces no-write mode.

BOARD_PLATFORM=mock

# Claim owner for drained items (board-ops.md § Identities). The mock adapter
# accepts any string; a declared value keeps the drain from having to improvise
# one at claim time (retro finding, release-gate batch 2026-09-26).
OPERATOR_ID=kjell
